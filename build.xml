<project name="java-ds" default="compile" basedir=".">
    <property name="src" location="src"/>
    <property name="build" location="build"/>

    <target name="init">
        <mkdir dir="${build}"/>
    </target>

    <target name="compile" depends="init" description="Compila o código">
        <javac srcdir="${src}" destdir="${build}"/>
    </target>

    <target name="clean">
        <delete dir="${build}"/>
    </target>
</project>